{
  "name": "wannarap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "npm run build && concurrently -k -n api,web \"node --watch --env-file-if-exists=.env backend/server.js\" \"vite build --watch --config frontend/vite.config.js --configLoader native\"",
    "build": "vite build --config frontend/vite.config.js --configLoader native",
    "start": "node --env-file-if-exists=.env backend/server.js",
    "test": "node --test backend/tests/*.test.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "vite": "^6.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
